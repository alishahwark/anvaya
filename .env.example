# Anvaya environment. Copy to .env (never commit .env). Anvaya looks for .env in this
# folder first, then one folder above it.
#
# The app runs fully WITHOUT any key: every page, the official documents and the prepared
# answers work. Keys only enable AI answers to new, free-form questions.

# Course key (Portkey). Uses the course-approved model gpt-6-luna.
PORTKEY_API_KEY=

# Alternative: your own OpenAI key, if you choose to pay for a different model.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional, advanced
# ANVAYA_MODEL=gpt-6-luna            # override the Portkey model name
# ANVAYA_BYPASS_GATEWAY_CACHE=1      # benchmarks only: skip the Portkey response cache
# ANVAYA_QA_ENABLED=true             # expose /internal/qa in a production build
# ANVAYA_LEGACY_API=1                # re-enable the superseded /api/interpret route
